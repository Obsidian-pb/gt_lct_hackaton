# Токен доступа: backend_new отправляет его в Authorization: Bearer <значение>.
# Без явной настройки сервис отвечает 503 на все операции, кроме /health и документации.
AI_SERVICE_TOKEN=change-me-ai-service-token

# Разрешённые источники (JSON-список)
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# ИИ-провайдер (ключ живёт только в этом микросервисе и не отдаётся наружу).
# Провайдер: openai | gigachat | gemini | anthropic | openai_compatible
AI_PROVIDER=openai_compatible
AI_API_KEY=
# Точное имя текстовой модели (для openai_compatible обязательно; auto — автоподбор)
AI_MODEL=auto
# Базовый HTTPS-адрес API (обязателен для openai_compatible, например https://api.aitunnel.ru/v1)
AI_BASE_URL=
# Настройки GigaChat (необязательны)
AI_SCOPE=auto
AI_OAUTH_URL=
AI_CA_BUNDLE=
AI_VERIFY_SSL=true