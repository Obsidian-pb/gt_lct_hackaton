# --- База данных -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trainer:trainer@localhost:5432/trainer
SECRET_KEY=change-me

# --- Норматив ----------------------------------------------------------------
# 30 секунд на подтверждение приёма карточки — требование ПП РФ № 1931.
# Преподаватель может изменить норматив для конкретного занятия.
DEFAULT_RESPONSE_DEADLINE_SECONDS=30

# --- ИИ-оценка ---------------------------------------------------------------
# Переключение контура выполняется только настройками, код не меняется.
#
# Демонстрационный стенд — внешний API:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Изолированный контур — локальная модель (Ollama):
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:14b-instruct
#
# Без модели вовсе — сверка комментариев по ключевым словам:
LLM_PROVIDER=stub
