# --- База данных -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trainer:trainer@localhost:5432/trainer
SECRET_KEY=change-me

# --- Норматив ----------------------------------------------------------------
# 30 секунд на подтверждение приёма карточки — требование ПП РФ № 1931.
# Преподаватель может изменить норматив для конкретного занятия.
DEFAULT_RESPONSE_DEADLINE_SECONDS=30

# --- ИИ-оценка ---------------------------------------------------------------
# Переключение контура выполняется только настройками, код не меняется.
#
# ВАЖНО: переменные ниже задают лишь начальное состояние. Как только
# администратор сохранит настройки в разделе «Конфигурация», действовать
# будет значение из базы — правка этого файла на него уже не повлияет.
#
# Демонстрационный стенд — внешний API:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Изолированный контур — локальная модель (Ollama):
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:14b-instruct
#
# Модель в локальной сети (llama.cpp, vLLM, LM Studio — интерфейс один):
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://192.168.0.10:8080/v1
#   LLM_API_KEY=...
#   LLM_MODEL=qwen3-coder
#   LLM_DISABLE_THINKING=true
#
# Без модели вовсе — сверка комментариев по ключевым словам:
LLM_PROVIDER=stub

# --- Журналирование ----------------------------------------------------------
# Глубина хранения журнала аудита. 180 суток — нижняя граница из ТЗ («журнал
# безопасности хранится не менее шести месяцев»), меньшее значение не примут
# ни эта переменная, ни раздел «Конфигурация».
AUDIT_RETENTION_DAYS=180
# Подробность журнала приложения: ERROR, WARNING, INFO или DEBUG.
LOG_LEVEL=INFO

# --- Сравнение моделей -------------------------------------------------------
# Второй профиль для scripts/compare_llm.py: он прогоняет размеченные примеры
# из памятки через провайдера из настроек выше и через этот, и показывает
# ложные замечания, пропуски и найденные орфографические ошибки по отдельности.
# На рабочее приложение не влияет — читается только скриптом.
#   ALT_LLM_BASE_URL=http://192.168.0.10:8080/v1
#   ALT_LLM_API_KEY=...
#   ALT_LLM_MODEL=qwen3-coder
#   ALT_LLM_DISABLE_THINKING=true
