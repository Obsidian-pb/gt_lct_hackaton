# Подключение к PostgreSQL (asyncpg). По умолчанию совпадает с docker-compose.yml
DATABASE_URL=postgresql+asyncpg://system112:system112@localhost:5432/system112_trainer

# Безопасность JWT — обязательно сменить в production
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Приложение
APP_NAME=System-112 Trainer API
APP_VERSION=0.1.0
DEBUG=true

# CORS (JSON-список)
CORS_ORIGINS=["*"]

# ИИ-провайдер (ключ живёт только на сервере и никогда не отдаётся браузеру).
# Провайдер: openai | gigachat | gemini | anthropic | openai_compatible
AI_PROVIDER=openai_compatible
AI_API_KEY=
# Точное имя текстовой модели (для openai_compatible обязательно; auto — автоподбор)
AI_MODEL=auto
# Базовый HTTPS-адрес API (обязателен для openai_compatible, например https://api.aitunnel.ru/v1)
AI_BASE_URL=
# Настройки GigaChat (необязательны)
AI_SCOPE=auto
AI_OAUTH_URL=
AI_CA_BUNDLE=
AI_VERIFY_SSL=true