@echo off
rem Образец настроек переносного комплекта. Чтобы они действовали,
rem скопируйте файл под именем settings.cmd рядом со start.cmd и уберите
rem "rem " перед нужными строками.

rem Порт, на котором открывается тренажёр (по умолчанию 8090).
rem set "WEB_PORT=8091"

rem Доступ ученикам из класса по адресу этого компьютера в сети
rem (по умолчанию только с этого компьютера). При первом запуске Windows
rem спросит про брандмауэр — нужно разрешить доступ в частных сетях.
rem set "WEB_HOST=0.0.0.0"

rem Порт PostgreSQL (по умолчанию 5433, чтобы не мешать установленному).
rem set "PGPORT=5434"

rem Сколько ядер отдать языковой модели (по умолчанию — все).
rem set "LLM_THREADS=4"

rem Пароль учебных учётных записей. Без него пароль совпадает с логином.
rem set "DEMO_PASSWORD=секрет"
