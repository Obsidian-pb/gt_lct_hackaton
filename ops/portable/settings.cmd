@echo off
rem Настройки комплекта, которые действуют сразу после распаковки.
rem Остальные возможные настройки — в settings.example.cmd; их можно
rem переносить сюда. Архив обновления этот файл не заменяет.

rem Доступ ученикам из класса по адресу этого компьютера в сети.
rem При первом запуске Windows спросит про брандмауэр — нужно разрешить
rem доступ в частных сетях. Чтобы тренажёр открывался только на этом
rem компьютере, поставьте "rem " в начале следующей строки.
set "WEB_HOST=0.0.0.0"

rem Тренажёр виден всему классу, поэтому стоит задать свой пароль учебных
rem учётных записей (admin, teacher, student): уберите "rem " и впишите его.
rem Без этой строки пароль совпадает с логином.
rem set "DEMO_PASSWORD=секрет"
